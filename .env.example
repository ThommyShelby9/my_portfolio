# Public site origin, used for canonical URLs and sitemap
NEXT_PUBLIC_SITE_URL=
# Firebase project id (rostel-portfolio-v6)
FIREBASE_PROJECT_ID=
# Base64 of the service-account JSON key (server only)
FIREBASE_SERVICE_ACCOUNT=
# SMTP server host
SMTP_HOST=
# SMTP port (465 uses TLS, default 587)
SMTP_PORT=
# SMTP username
SMTP_USER=
# SMTP password
SMTP_PASS=
# Recipient of form submissions
MAIL_TO=
# Sender address (defaults to SMTP_USER)
MAIL_FROM=
