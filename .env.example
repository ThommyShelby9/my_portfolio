# Public site origin, used for canonical URLs and sitemap
NEXT_PUBLIC_SITE_URL=
# Firebase project id (rostel-portfolio-v6)
FIREBASE_PROJECT_ID=
# Base64 of the service-account JSON key (server only)
FIREBASE_SERVICE_ACCOUNT=
# SMTP server host
SMTP_HOST=
# SMTP port (465 uses TLS, default 587)
SMTP_PORT=
# SMTP username
SMTP_USER=
# SMTP password
SMTP_PASS=
# Recipient of form submissions (defaults to rmissimawu@gmail.com)
MAIL_TO=
# Sender address (defaults to SMTP_USER; required when SMTP_USER is not an address, e.g. an API-key login)
MAIL_FROM=

# Cloudflare sits in front of the site: cf-connecting-ip and cf-ipcountry are trusted by default.
# Set to 0 only when the app is served WITHOUT Cloudflare (the headers would then be spoofable).
TRUST_CF_CONNECTING_IP=

# Build-time only, never in production: 1 enables /?dna=poster for scripts/dna-poster.mjs
# (pnpm dna:poster sets it itself).
NEXT_PUBLIC_DNA_POSTER=
